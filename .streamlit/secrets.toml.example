# En Streamlit Community Cloud: App -> Settings -> Secrets, pega estas 3 líneas con tus valores.
# En local: copia este archivo como .streamlit/secrets.toml (está en .gitignore).
QDRANT_URL = "https://<cluster-id>.<region>.cloud.qdrant.io:6333"
QDRANT_API_KEY = "<tu-api-key-de-qdrant>"
GEMINI_API_KEY = "<tu-api-key-de-google-ai-studio>"
